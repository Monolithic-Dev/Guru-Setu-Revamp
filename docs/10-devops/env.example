# GuruSetu environment. Copy to ./.env (gitignored). Meanings: docs/04-backend/backend.md §8.

# --- Database ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-12chars-min

# --- Auth ---
JWT_SECRET_KEY=change-me-to-48-random-url-safe-characters-xxxxxxxxxx
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000
LOGIN_RATE_LIMIT_PER_MIN=10

# --- Uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
UPLOAD_RATE_LIMIT_PER_HOUR=20

# --- AI ---
# groq | anthropic | none. D-2: the extractor runs on Groq.
LLM_PROVIDER=groq
# Unused unless LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_TIMEOUT_S=25
MAX_LLM_CALLS_PER_DAY=200
EXTRACTION_CACHE_DIR=/app/extraction_cache
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_HOME=/models

# --- Verification thresholds ---
CERT_AUTO_CERTIFY_MIN=0.85
NAME_MATCH_MIN=85
PHASH_MAX_DISTANCE=6
# Tamper check: EXIF Software tag only; ELA_THRESHOLD=0 turns ELA off (decisions-log L-7)
TAMPER_CHECK_ENABLED=true
ELA_THRESHOLD=0

# --- Fit scoring ---
FIT_READY_MIN=65
FIT_CLOSE_MIN=40
SIM_MIN=0.60

# --- Mentoring rules ---
MIN_MEETINGS_PER_TERM=2
ATTENTION_NO_SESSION_DAYS=45
ISSUE_STALE_DAYS=14
SESSION_CONFIRM_DAYS=7
MENTOR_LOAD_WARN=20
AT_RISK_ATTENDANCE_PCT=75
AT_RISK_CGPA_DROP=1.0
REMINDER_TERM_END_DAYS=30
CURRENT_TERM_ID=
TODAY_OVERRIDE=

# --- Ops ---
LOG_LEVEL=INFO

# --- Frontend (build arg) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
